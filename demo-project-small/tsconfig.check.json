{
  // Config de TYPECHECK (no-emit), utilisée par `typecheck` et `typecheck:tsgo`.
  //
  // Pourquoi pas `tsc -b --noEmit` comme dans l'énoncé ? Parce qu'avec des
  // project references, `-b --noEmit` lève TS6310 ("Referenced project may not
  // disable emit") sur tsc ET tsgo. Le pattern fiable pour type-checker un
  // monorepo sans rien émettre = un programme PLAT (non-composite) qui résout
  // les imports cross-package vers la SOURCE via des `paths` relatifs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "paths": {
      "@demo/core": ["./packages/core/src/index.ts"],
      "@demo/api": ["./packages/api/src/index.ts"]
    }
  },
  "include": ["packages/*/src"]
}
