{
  // tsconfig ISOLÉ : référencé par aucun autre projet, donc les gotchas ne
  // cassent jamais `pnpm typecheck` / `typecheck:tsgo` à la racine.
  // On le lance à la main pendant la démo pour SHOW l'erreur structurelle :
  //   tsc   -p gotchas/tsconfig.json
  //   tsgo  -p gotchas/tsconfig.json
  // (Pour le gotcha esModuleInterop, voir gotchas/esModuleInterop-removed.tsconfig.json)
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-gotchas",
    // Flag "type-stripping" : casse `const enum` (non effaçable). -> const-enum.ts
    "erasableSyntaxOnly": true
  },
  "include": ["const-enum.ts", "jsdoc-template.ts", "esModuleInterop-false.ts"]
}
