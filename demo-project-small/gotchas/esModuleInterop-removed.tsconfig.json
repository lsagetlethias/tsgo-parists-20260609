{
  // Config dédiée au gotcha esModuleInterop. Isolée car l'option déclenche une
  // erreur de CONFIG qui stoppe tout le reste -> on la garde à part.
  //   tsc   -p gotchas/esModuleInterop-removed.tsconfig.json
  //   tsgo  -p gotchas/esModuleInterop-removed.tsconfig.json
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    // En TS 7, `esModuleInterop: false` n'existe plus.
    //   tsc 6.x -> TS5107 (déprécié, exige "ignoreDeprecations")
    //   tsgo    -> TS5108 (option SUPPRIMÉE, retire-la)
    "esModuleInterop": false
  },
  "include": ["esModuleInterop-false.ts"]
}
